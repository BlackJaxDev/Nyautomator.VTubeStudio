{
  "$schema": "nyautomator.template.v1",
  "id": "vtube-studio-reward-expression",
  "kind": "automation-workflow",
  "title": "Reward expression",
  "group": "VTube Studio",
  "summary": "channel point reward -> set VTube Studio expression -> timer -> reset to neutral.",
  "description": "Reward expression: channel point reward -> set VTube Studio expression -> timer -> reset to neutral.",
  "rootOnly": true,
  "generatedFrom": "docs/template-ideas.md",
  "triggers": [
    {
      "id": "trigger-1",
      "actionType": "Twitch.EventSub.channel.channel_points_custom_reward_redemption.add.1.ByReward",
      "actionConfig": {
        "Reward": ""
      },
      "actionName": "Channel Point Redemption"
    }
  ],
  "messageTemplate": "{{UserName}} redeemed {{Reward.Title}}: {{UserInput}}",
  "constants": [
    {
      "key": "mediaPath",
      "name": "Alert Media Path",
      "value": "",
      "type": "string"
    },
    {
      "key": "audioPath",
      "name": "Alert Audio Path",
      "value": "",
      "type": "string"
    },
    {
      "key": "durationSeconds",
      "name": "Alert Duration Seconds",
      "value": 6,
      "type": "float64"
    },
    {
      "key": "playTextToSpeech",
      "name": "Play Text To Speech",
      "value": false,
      "type": "boolean"
    },
    {
      "key": "vtubeHotkeyId",
      "name": "VTube Studio Hotkey ID",
      "value": "",
      "type": "string"
    },
    {
      "key": "vtubeExpressionFile",
      "name": "VTube Studio Expression File",
      "value": "",
      "type": "string"
    }
  ],
  "steps": [
    "alert",
    {
      "kind": "vtube-hotkey",
      "nodeKind": "reaction",
      "type": "Action.VTubeStudio.TriggerHotkey",
      "name": "Trigger VTube Studio Hotkey",
      "config": {
        "HotkeyId": "",
        "ItemInstanceId": ""
      },
      "bindings": {
        "vtubeHotkeyId": "HotkeyId"
      }
    },
    {
      "kind": "vtube-expression",
      "nodeKind": "reaction",
      "type": "Action.VTubeStudio.SetExpression",
      "name": "Set VTube Studio Expression",
      "config": {
        "ExpressionFile": "",
        "Active": true,
        "FadeTimeSeconds": 0.25
      },
      "bindings": {
        "vtubeExpressionFile": "ExpressionFile"
      }
    },
    "log"
  ]
}
